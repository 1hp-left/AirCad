# AirCad uses exactly two provider keys. Keep real values in .env only.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# The live OpenRouter catalog currently lists Qwen ASR Flash below Fish
# Transcribe 1's price. AirCad falls back to Fish if the primary route fails.
OPENROUTER_TRANSCRIPTION_MODEL=qwen/qwen3-asr-flash-2026-02-10
OPENROUTER_TRANSCRIPTION_FALLBACK_MODEL=fish-audio/transcribe-1

# Free Fish Audio speech route requested for low-volume use.
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_VOICE=default

NVIDIA_MODEL=z-ai/glm-5.2

# Optional local server settings.
AIRCAD_PORT=5173
